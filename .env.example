# Environment Configuration Example
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/nestly
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api
JWT_SECRET=your_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d
COOKIE_NAME=nestly_token
NODE_ENV=development

# Redis Cache & Performance Layer
REDIS_URL=redis://localhost:6379

# Payment Integration (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Image Upload & Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Notification Provider (Nodemailer / SMTP)
EMAIL_PROVIDER=smtp
EMAIL_FROM=nestly-support@example.com
EMAIL_API_KEY=your_email_provider_api_key
